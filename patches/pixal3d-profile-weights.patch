@@ -36,5 +36,5 @@ def __getattr__(name):


-def from_pretrained(path: str, **kwargs):
+def from_pretrained(path: str, *, load_timing=None, **kwargs):
     """
     Load a model from a pretrained checkpoint.
@@ -47,4 +47,5 @@ def from_pretrained(path: str, **kwargs):
     import os
     import json
+    from time import monotonic
     from safetensors.torch import load_file
     is_local = os.path.exists(f"{path}.json") and os.path.exists(f"{path}.safetensors")
@@ -63,6 +64,18 @@ def from_pretrained(path: str, **kwargs):
     with open(config_file, 'r') as f:
         config = json.load(f)
+    started = monotonic()
     model = __getattr__(config['name'])(**config['args'], **kwargs)
-    model.load_state_dict(load_file(model_file), strict=False)
+    if load_timing is None:
+        model.load_state_dict(load_file(model_file), strict=False)
+        return model
+
+    load_timing("construct", monotonic() - started)
+    started = monotonic()
+    # mmap defers file reads into load_state_dict. pread reads the data here.
+    state_dict = load_file(model_file, backend="pread")
+    load_timing("checkpoint_read", monotonic() - started)
+    started = monotonic()
+    model.load_state_dict(state_dict, strict=False)
+    load_timing("state_dict", monotonic() - started)

     return model
